# Fixed pubnet ledger range for the recorded benchmark (10001 ledgers).
START_LEDGER=55000000
END_LEDGER=55010000

# Smoke range for harness validation (override START_LEDGER/END_LEDGER when testing).
SMOKE_START_LEDGER=55000000
SMOKE_END_LEDGER=55001000

WORKER_COUNT=8

# Postgres (infra/docker-compose.tui-indexer.yml)
DATABASE_URL=postgresql://explorer:explorer_dev@localhost:54330/stellar_explorer_tui?sslmode=disable

# ClickHouse (this directory's docker-compose.yml)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=stellar_benchmark
CLICKHOUSE_DSN=clickhouse://default:@localhost:9000/stellar_benchmark

# Query timing
QUERY_REPEATS=11
RESULTS_DIR=results
